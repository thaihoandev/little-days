# LOCAL DEVELOPMENT: fill only the 3 CLOUDINARY credentials below, then npm run dev.
# Keep these credentials on the backend. Never add a VITE_ prefix to secrets.
# Set NODE_ENV=production only when serving a production build with npm start.
HOST=127.0.0.1
PORT=3001
WEB_PORT=5173
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=data

# Empty = SQLite. No database service is required for npm run dev.
DATABASE_URL=

# Use local to run without a cloud account. s3 remains supported for compatibility.
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=little-days

COOKIE_SECURE=false
RENDER_WORKER_MODE=external
RENDER_LEASE_MS=30000
RENDER_POLL_MS=1000
RENDER_TIMEOUT_MS=900000
DISABLE_RENDER_WORKER=false

# Only used by Docker Compose PostgreSQL. setup:env generates a random value.
POSTGRES_PASSWORD=replace-with-a-random-password

# Optional S3 compatibility, unused when STORAGE_DRIVER=cloudinary.
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_BUCKET=your-private-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=little-days

# Email: local writes private messages under DATA_DIR/mail (development only).
# Existing .env files may omit these; local is the development default.
# Production default is disabled until SMTP is configured. Never use local in production.
MAIL_DRIVER=local
# Render Free: set MAIL_DRIVER=brevo, MAIL_FROM and BREVO_API_KEY in Render Environment.
# HTTPS providers do not use SMTP_HOST/SMTP_PORT/SMTP_PASSWORD.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=Little Days <noreply@your-domain.example>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
AUTH_RATE_LIMIT_PER_MINUTE=30

# Set only when API is behind that many trusted reverse proxies.
TRUST_PROXY_HOPS=0

# Defaults also apply when an existing .env omits these.
QUOTA_STORAGE_MB=512
QUOTA_EXPORTS_PER_DAY=10
QUOTA_VIDEO_SECONDS_PER_DAY=600
QUOTA_QUEUE_SIZE=20
VIDEO_RETENTION_DAYS=30
ORPHAN_GRACE_HOURS=24
MAINTENANCE_ENABLED=true
# Optional operator API; unset means disabled. Minimum 32 random characters.
# OPS_TOKEN=
# OPS_TOKEN_FILE=

# Optional operational emails using the API's existing mail provider.
# Configure these in Render Environment for cloud; no additional env file is needed.
OPS_ALERT_ENABLED=false
# OPS_ALERT_EMAIL=operator@example.com
