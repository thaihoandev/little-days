# LOCAL WORKER FOR THE FREE CLOUD WEB/API. Never upload this filled file.
# Same Neon database and Cloudinary namespace as the Render API.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=little-days-cloud
DATA_DIR=data-cloud-worker
APP_ORIGIN=https://your-api.onrender.com
RENDER_WORKER_MODE=external
DISABLE_RENDER_WORKER=false
RENDER_LEASE_MS=30000
RENDER_POLL_MS=1500
RENDER_TIMEOUT_MS=900000
MAIL_DRIVER=disabled
QUOTA_STORAGE_MB=256
QUOTA_EXPORTS_PER_DAY=5
QUOTA_VIDEO_SECONDS_PER_DAY=300
QUOTA_QUEUE_SIZE=10
VIDEO_RETENTION_DAYS=7
ORPHAN_GRACE_HOURS=24
MAINTENANCE_ENABLED=true
