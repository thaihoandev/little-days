{
  "name": "our-little-days",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:journal": "tsx scripts/pilot-qa.ts journal",
    "test:design": "tsx scripts/pilot-qa.ts design",
    "test:templates": "tsx scripts/pilot-qa.ts templates",
    "music:generate": "node scripts/generate-music.mjs",
    "test:pilot": "tsx scripts/pilot-qa.ts",
    "test:save-recovery": "tsx scripts/pilot-qa.ts save-recovery",
    "test:gestures": "tsx scripts/pilot-qa.ts gestures",
    "backup:scheduled": "node --import tsx scripts/scheduled-backup.ts",
    "test:scheduled-backup": "tsx scripts/smoke-scheduled-backup.ts",
    "backup:key": "node --import tsx scripts/backup-crypto.ts key",
    "backup:seal": "node --env-file-if-exists=.env --import tsx scripts/backup-crypto.ts seal",
    "backup:open": "node --env-file-if-exists=.env --import tsx scripts/backup-crypto.ts open",
    "ops:monitor": "node --env-file-if-exists=.env --import tsx scripts/monitor-ops.ts",
    "test:ops": "tsx scripts/smoke-ops.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "concurrently -k -n api,worker,web \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch apps/worker/src/main.ts",
    "worker": "node --env-file-if-exists=.env build/apps/worker/src/main.js",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "tsx scripts/smoke-api.ts",
    "test:s3": "tsx scripts/smoke-s3.ts",
    "test:cloudinary": "tsx scripts/smoke-cloudinary.ts",
    "test:migration": "tsx scripts/smoke-migration.ts",
    "test:workers": "tsx scripts/smoke-workers.ts",
    "storage:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-storage.ts",
    "start": "node --env-file-if-exists=.env build/apps/api/src/main.js",
    "test:ui": "tsx scripts/smoke-ui.ts",
    "test:production": "tsx scripts/smoke-production.ts",
    "format": "prettier --write apps packages scripts tests package.json tsconfig.json",
    "format:check": "prettier --check apps packages scripts tests package.json tsconfig.json",
    "video:browser": "remotion browser ensure",
    "test:render": "tsx scripts/smoke-render.ts",
    "test:layout": "tsx scripts/smoke-layout.ts",
    "test:video": "tsx scripts/smoke-custom-video.ts",
    "test:video-ui": "tsx scripts/smoke-video-ui.ts",
    "backup:create": "node --env-file-if-exists=.env --import tsx scripts/backup-data.ts create",
    "backup:verify": "node --import tsx scripts/backup-data.ts verify",
    "backup:restore": "node --env-file-if-exists=.env --import tsx scripts/backup-data.ts restore",
    "test:history-ui": "tsx scripts/smoke-history-ui.ts",
    "test:backup": "tsx scripts/smoke-backup.ts",
    "mail:outbox": "node --env-file-if-exists=.env --import tsx scripts/mail-outbox.ts",
    "test:auth": "tsx scripts/smoke-auth.ts",
    "test:auth-ui": "tsx scripts/smoke-auth-ui.ts",
    "test:smtp": "tsx scripts/smoke-smtp.ts",
    "test:mail": "tsx scripts/smoke-http-mail.ts",
    "cleanup:accounts": "node --env-file-if-exists=.env --import tsx scripts/cleanup-accounts.ts",
    "test:deletion": "tsx scripts/smoke-deletion.ts",
    "test:deletion-ui": "tsx scripts/smoke-deletion-ui.ts",
    "setup:staging": "node scripts/setup-staging.mjs",
    "cleanup:media": "node --env-file-if-exists=.env --import tsx scripts/cleanup-media.ts",
    "backup:prune": "node --env-file-if-exists=.env --import tsx scripts/backup-retention.ts",
    "backup:drill": "node --env-file-if-exists=.env --import tsx scripts/restore-drill.ts",
    "ops:check": "node --env-file-if-exists=.env --import tsx scripts/check-ops.ts",
    "test:load": "tsx scripts/smoke-load.ts",
    "test:postgres": "tsx scripts/smoke-postgres.ts",
    "test:container": "tsx scripts/smoke-container.ts",
    "build:web": "tsc --noEmit -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "setup:cloud": "node scripts/setup-cloud.mjs",
    "setup:vercel": "node scripts/setup-vercel.mjs",
    "worker:cloud": "node --env-file=.env.cloud scripts/run-cloud-worker.mjs",
    "backup:create:cloud": "node --env-file=.env.cloud --import tsx scripts/backup-data.ts create"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "@fontsource/caveat": "^5.2.0",
    "@fontsource/lora": "^5.2.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@remotion/bundler": "4.0.440",
    "@remotion/cli": "4.0.440",
    "@remotion/player": "4.0.440",
    "@remotion/renderer": "4.0.440",
    "cloudinary": "2.11.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "multer": "^2.0.0",
    "nodemailer": "10.2.1",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "remotion": "4.0.440",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
